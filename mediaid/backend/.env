# ── Server
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas
# Get from: https://cloud.mongodb.com → Your Cluster → Connect → Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://mediaiduser:mediaid2004@cluster0.fbjigal.mongodb.net/mediaid?appName=Cluster0&retryWrites=true&w=majority

# ── JWT
JWT_SECRET=mediaid_change_this_to_a_long_random_string_min32chars
JWT_EXPIRES_IN=7d

# ── Frontend CORS
FRONTEND_URL=http://localhost:5173

# ── Cloudinary (Cloud video/image storage)
# Get from: https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=dille4s7u
CLOUDINARY_API_KEY=632593615199959
CLOUDINARY_API_SECRET=hgLJxqVzsVfgs3ZpdpNUnDlgvZ0
CLOUDINARY_UPLOAD_PRESET=mediaid_uploads

