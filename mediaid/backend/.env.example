# ══════════════════════════════════════════════════════════
# MediAid AI — Backend Environment Configuration (Example)
# ══════════════════════════════════════════════════════════

# ── Server
PORT=5000
NODE_ENV=production

# ── MongoDB Atlas
# Get from: https://cloud.mongodb.com → Your Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mediaid?retryWrites=true&w=majority

# ── JWT
# Generate a long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret_here
JWT_EXPIRES_IN=7d

# ── Frontend CORS
# The URL where your frontend is deployed (e.g., https://mediaid-app.vercel.app)
FRONTEND_URL=http://localhost:5173

# ── Cloudinary (Cloud video/image storage)
# Get from: https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=mediaid_uploads

# ── Google Gemini AI
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Upload limits (for local fallback)
MAX_FILE_SIZE_MB=100
UPLOAD_PATH=./uploads
